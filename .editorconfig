# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

# Web dev formats (HTML, CSS, JS, JSON) usually prefer 2 spaces
[*.{html,css,js,json,md,yaml,yml}]
indent_size = 2

# Makefile always requires tabs
[Makefile]
indent_style = tab
